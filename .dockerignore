# Build context for every `docker build ... .` from the repository root
# (platform/aurora-steer/Dockerfile, platform/dashboard/Dockerfile,
# simulations/gcp/Dockerfile.gx-runner, surrogates/itg_surrogate/gke/Dockerfile.tpu).
# Keep secrets, local state, virtualenvs and build artifacts out of the context and the images.

# VCS, CI and internal review notes
.git
.github
.agent
.agents
docs/review

# Secrets and local environment (templates are harmless and kept)
.env
.env.*
!.env.example
gcp.env
**/gcp.env
**/*.pem
**/*.key
**/*credentials*.json
**/service-account*.json

# Virtualenvs, caches and Python build artifacts
.venv
.venv-*
venv
env
**/__pycache__
**/*.py[codz]
**/*.egg-info
**/build
**/dist
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.coverage
**/coverage.xml

# Datasets, checkpoints, and scratch outputs
**/*.h5
**/*.hdf5
**/*.npz
**/*.orbax
checkpoints
outputs
wandb

# C/C++/Fortran/CUDA build artifacts
**/*.o
**/*.so
**/*.dylib
**/*.a
**/*.mod
CMakeFiles
CMakeCache.txt
cmake-build-*

# Runtime state, outboxes and local telemetry databases
**/state.json*
**/state.lock
**/*audit.jsonl
**/outbox*.jsonl
**/*.duckdb
**/*.duckdb.wal
simulations/hpc/queue/*/*

# Terraform working files and state
**/.terraform
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/*.tfvars
**/*.tfvars.json

# OS / editor artifacts
**/.DS_Store
**/*.swp
**/*~
