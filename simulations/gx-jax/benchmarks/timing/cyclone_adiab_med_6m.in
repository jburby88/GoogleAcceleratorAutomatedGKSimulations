# Medium Grid (6.0M DOF — GX Paper Table 1 Baseline: 11 ms/step on 1 x A100)
# Copy of cyclone_miller_adiabatic_electrons.in with nhermite = 16, nlaguerre = 4 (nx=192, ny=64, ntheta=24)

 debug = false

[Dimensions]
 ntheta = 24
 nperiod = 1
 ny = 64
 nx = 192

 nhermite = 16
 nlaguerre = 4
 nspecies = 1

[Domain]
 y0 = 28.2
 boundary = "linked"

[Physics]
 beta = 0.0
 nonlinear_mode = true

[Time]
 t_max = 400.0
 cfl = 0.9
 scheme = "rk3"

[Initialization]
 ikpar_init = 0
 init_field = "density"
 init_amp = 1.0e-3

[Geometry]
 geo_option = "miller"
 rhoc = 0.5
 Rmaj = 2.77778
 R_geo = 2.77778
 qinp = 1.4
 shat = 0.8
 shift = 0.0
 akappa = 1.0
 akappri = 0.0
 tri = 0.0
 tripri = 0.0
 betaprim = 0.0

[species]
 z     = [ 1.0,      -1.0     ]
 mass  = [ 1.0,       2.7e-4  ]
 dens  = [ 1.0,       1.0     ]
 temp  = [ 1.0,       1.0     ]
 tprim = [ 2.49,       0.0     ]
 fprim = [ 0.8,       0.0     ]
 vnewk = [ 0.0,       0.0     ]
 type  = [ "ion",  "electron" ]

[Boltzmann]
 add_Boltzmann_species = true
 Boltzmann_type = "electrons"
 tau_fac = 1.0

[Dissipation]
 closure_model = "none"
 hypercollisions = true
 hyper = true
 D_hyper = 0.05
 p_hyper = 2

[Restart]
 restart = false
 save_for_restart = false

[Diagnostics]
 nwrite = 100
 nwrite_big = 5000
 free_energy = true
 fluxes = true
 fields = true
 moments = true
