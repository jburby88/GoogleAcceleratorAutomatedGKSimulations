# Nonlinear ITG/TEM turbulence benchmark in 3D W7-X geometry with kinetic electrons
# and Non-Twisting Flux Tube (NTFT: nonTwist = true) formulation for low-shear stellarators.

 debug = false

[Dimensions]
 ntheta = 48
 nperiod = 1
 ny = 96
 nx = 96

 nhermite = 16
 nlaguerre = 4
 nspecies = 2

[Domain]
 y0 = 21.0
 boundary = "fix aspect"
 nonTwist = true

[Physics]
 beta = 1e-3
 nonlinear_mode = true
 ei_colls = false

[Time]
 t_max = 200.0
 dt = 0.1
 cfl = 1.0
 scheme = "rk3"

[Initialization]
 gaussian_init = true
 init_field = "density"
 init_amp = 1.0e-3

[Geometry]
 geo_option = "vmec"
 vmec_file = "../../linear/ITG_w7x/wout_w7x.nc"
 alpha = 0.0
 npol_min = 1.1
 desired_normalized_toroidal_flux = 0.64

[species]
 z     = [ 1.0,      -1.0     ]
 mass  = [ 1.0,       2.7e-4  ]
 dens  = [ 1.0,       1.0     ]
 temp  = [ 1.0,       1.0     ]
 tprim = [ 3.0,       3.0     ]
 fprim = [ 1.0,       1.0     ]
 vnewk = [ 0.000167,  0.01    ]
 type  = [ "ion",  "electron" ]

[Dissipation]
 closure_model = "none"
 hypercollisions = true
 hyper = true
 D_hyper = 0.05

[Restart]
 restart = false
 save_for_restart = false

[Diagnostics]
 nwrite = 100
 free_energy = true
 fluxes = true
 fields = false
 moments = false
