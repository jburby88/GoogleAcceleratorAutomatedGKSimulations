# Nonlinear ITG turbulence calculation in 3D W7-X VMEC geometry (Boltzmann electrons)
# Matches Mandell et al. (2024) / arXiv:2209.06731 §6.2.2 & Appendix D.6 coarse W7-X benchmark:
# boundary = "linked", npol = 1, nx = 64, ny = 192, ntheta = 128, nhermite = 8, nlaguerre = 4,
# tprim = 3.0, fprim = 1.0, t_max = 200.0.

 debug = false

[Dimensions]
 ntheta = 128           # number of points along field line (theta) per 2pi segment
 nperiod = 1            # number of 2pi segments along field line is 2*nperiod-1
 ny = 192               # number of real-space grid-points in y (naky = 64)
 nx = 64                # number of real-space grid-points in x (nakx = 43)

 nhermite = 8           # number of hermite moments (v_parallel resolution)
 nlaguerre = 4          # number of laguerre moments (mu B resolution)
 nspecies = 1           # number of evolved kinetic species (adiabatic electrons)

[Domain]
 y0 = 21.0              # binormal box scale (ky_min * rho_ref = 1 / y0)
 boundary = "linked"    # standard twist-shift linked boundary condition

[Physics]
 beta = 0.0
 nonlinear_mode = true

[Time]
 t_max = 200.0          # run to t = 200.0 (units of a / v_ti)
 dt = 0.1               # maximum timestep, adapted dynamically via CFL
 cfl = 1.0              # safety cushion factor on timestep size
 scheme = "rk3"         # SSPx3 / RK3 timestepping

[Initialization]
 ikpar_init = 0
 init_field = "density"
 init_amp = 1.0e-3

[Geometry]
 geo_option = "vmec"
 vmec_file = "../../linear/ITG_w7x/wout_w7x.nc"
 alpha = 0.0
 npol = 1
 desired_normalized_toroidal_flux = 0.64

[species]
 z     = [ 1.0,      -1.0     ]
 mass  = [ 1.0,       2.7e-4  ]
 dens  = [ 1.0,       1.0     ]
 temp  = [ 1.0,       1.0     ]
 tprim = [ 3.0,       0.0     ]
 fprim = [ 1.0,       0.0     ]
 vnewk = [ 0.01,      0.0     ]
 type  = [ "ion",  "electron" ]

[Boltzmann]
 add_Boltzmann_species = true
 Boltzmann_type = "electrons"
 tau_fac = 1.0

[Dissipation]
 closure_model = "none"
 hypercollisions = true
 hyper = true
 D_hyper = 0.05

[Restart]
 restart = false
 save_for_restart = false

[Diagnostics]
 nwrite = 50
 free_energy = true
 fluxes = true
 fields = false
 moments = false
