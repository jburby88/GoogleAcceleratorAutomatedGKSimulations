# Exact Appendix D.3 Nonlinear Cyclone ITG (L=4, M=8) to t_max = 2000.0 (Mandell et al. 2024, Table 1: Q_i/Q_GB = 7.4 +- 0.9)
 debug = false

[Dimensions]
 ntheta = 24
 nperiod = 1
 ny = 64
 nx = 192
 nhermite = 8
 nlaguerre = 4
 nspecies = 1

[Domain]
 y0 = 30.0
 boundary = "linked"

[Physics]
 beta = 0.0
 nonlinear_mode = true

[Time]
 t_max = 2000.0
 cfl = 0.9
 scheme = "rk3"

[Initialization]
 ikpar_init = 0
 init_field = "density"
 init_amp = 1.0e-3

[Geometry]
 geo_option = "miller"
 rhoc = 0.5
 Rmaj = 2.77778
 R_geo = 2.77778
 qinp = 1.4
 shat = 0.8
 shift = 0.0
 akappa = 1.0
 akappri = 0.0
 tri = 0.0
 tripri = 0.0
 betaprim = 0.0

[species]
 z     = [ 1.0,      -1.0     ]
 mass  = [ 1.0,       2.7e-4  ]
 dens  = [ 1.0,       1.0     ]
 temp  = [ 1.0,       1.0     ]
 tprim = [ 2.49,       0.0     ]
 fprim = [ 0.8,       0.0     ]
 vnewk = [ 0.01,      0.0     ]
 type  = [ "ion",  "electron" ]

[Boltzmann]
 add_Boltzmann_species = true
 Boltzmann_type = "electrons"
 tau_fac = 1.0

[Dissipation]
 closure_model = "none"
 hypercollisions = true
 nu_hyper_m = 0.1
 p_hyper_m = 6
 nu_hyper_l = 0.1
 p_hyper_l = 6
 hyper = true
 D_hyper = 0.05
 p_hyper = 2

[Restart]
 restart = false
 save_for_restart = false

[Diagnostics]
 nwrite = 200
 nwrite_big = 10000
 free_energy = true
 fluxes = true
 fields = false
 moments = false
