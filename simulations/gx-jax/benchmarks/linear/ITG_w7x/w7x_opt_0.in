# W7-X Stellarator Optimization Ensemble Member 0 (s = torflux = 0.25, r/a = 0.50)
 debug = false

[Dimensions]
 ntheta = 256
 nperiod = 1
 nky = 28
 nkx = 1
 nhermite = 16
 nlaguerre = 8
 nspecies = 1

[Domain]
 y0 = 10.0
 boundary = "linked"

[Physics]
 beta = 0.0
 nonlinear_mode = false

[Time]
 t_max = 200.0
 scheme = "rk4"

[Initialization]
 gaussian_init = true
 init_field = "density"
 init_amp = 1.0e-10

[Geometry]
 geo_option = "vmec"
 vmec_file = "wout_w7x.nc"
 alpha = 0.0
 npol = 6.0
 torflux = 0.25

[species]
 z     = [ 1.0,      -1.0     ]
 mass  = [ 1.0,       2.7e-4  ]
 dens  = [ 1.0,       1.0     ]
 temp  = [ 1.0,       1.0     ]
 tprim = [ 3.0,       0.0     ]
 fprim = [ 1.0,       0.0     ]
 vnewk = [ 0.0,       0.0     ]
 type  = [ "ion",  "electron" ]

[Boltzmann]
 add_Boltzmann_species = true
 Boltzmann_type = "electrons"
 tau_fac = 1.0

[Dissipation]
 closure_model = "none"
 hypercollisions = true

[Restart]
 restart = false
 save_for_restart = false

[Diagnostics]
 nwrite = 100
 omega  = true
 fields = false
 moments = false
 free_energy = true
