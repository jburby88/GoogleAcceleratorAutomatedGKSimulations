{
  "workstream": "kr2-gk-database",
  "backend": "gcp_batch",
  "campaign_id": "pilot_50",
  "environment": "prod",
  "skill_name": "sim-babysitter",
  "aurora_steer_url": "https://aurora-steer-example.us-central1.run.app",
  "gcp_project_id": "ut-austin-bsitter",
  "gcp_region": "us-central1",
  "candidate_regions": ["us-central1"],
  "network": "projects/ut-austin-bsitter/global/networks/ut-austin-bsitter-vpc",
  "subnetwork": "projects/ut-austin-bsitter/regions/us-central1/subnetworks/ut-austin-bsitter-subnet",
  "no_external_ip": true,
  "gcs_bucket": "ut-austin-bsitter-gk-dataset",
  "gcs_mount_path": "/mnt/gk_bucket",
  "gx_container_image": "us-central1-docker.pkg.dev/ut-austin-bsitter/aurora-platform/gx-runner:REPLACE_WITH_IMMUTABLE_RELEASE_TAG",
  "worker_service_account_email": "gx-batch-worker-sa@ut-austin-bsitter.iam.gserviceaccount.com",
  "spot_provisioning": true,
  "allow_on_demand": false,
  "allow_a100_fallback": false,
  "cpu_only": false,
  "max_run_duration_s": 28800,
  "max_pending_s": 1800,
  "queue_dir": "/mnt/gk_bucket/queue",
  "state_dir": "/mnt/gk_bucket/state",
  "dataset_output_dir": "/mnt/gk_bucket",
  "dataset_gcs_uri_prefix": "gs://ut-austin-bsitter-gk-dataset",
  "poll_interval_seconds": 120,
  "max_concurrent_jobs": 32,
  "max_retries": 2,
  "max_walltime_resubmits": 8,
  "max_unknown_polls": 10,
  "max_poll_errors": 3,
  "max_triage_deferrals": 3,
  "max_pending_hours": 168,
  "cancel_wait_seconds": 30,
  "cancel_timeout_seconds": 1800,
  "lock_stale_after_seconds": 300,
  "diagnostics_cmd": ["gx-diagnose"],
  "sim_time_target_default": 200.0,
  "dt_collapse_threshold": 0.01,
  "transient_discard_fraction": 0.5,
  "max_flux_drift": 0.5,
  "high_k_tail_threshold": 0.25,
  "convergence_time_fraction": 0.9,
  "allowed_parameters": {
    "nx": { "type": "int", "min": 16, "max": 512, "gene_path": "box.nx0", "gx_path": "Dimensions.nx", "warm_restart_allowed": false },
    "ny": { "type": "int", "min": 8, "max": 256, "gene_path": "box.nky0", "gx_path": "Dimensions.ny", "warm_restart_allowed": false },
    "nz": { "type": "int", "min": 16, "max": 256, "gene_path": "box.nz0", "gx_path": "Dimensions.ntheta", "warm_restart_allowed": false },
    "dt_max": { "type": "float", "min": 1e-6, "max": 0.1, "gene_path": "general.dt_max", "gx_path": "Time.dt", "warm_restart_allowed": true },
    "cfl_fraction": { "type": "float", "min": 0.05, "max": 0.95, "gene_path": "general.courant", "gx_path": "Time.cfl", "warm_restart_allowed": true },
    "hyperdiffusion_coeff": { "type": "float", "min": 0.0, "max": 2.0, "gene_path": "general.hyp_z", "gx_path": "Dissipation.D_hyper", "warm_restart_allowed": false }
  }
}
