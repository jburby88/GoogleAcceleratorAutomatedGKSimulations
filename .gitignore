# Python virtual environments & caches
.venv/
.venv-*/
venv/
env/
__pycache__/
*.py[codz]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Secrets & local environment files (NEVER commit)
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
service-account*.json

# Terraform state, plans & variable files (NEVER commit). Do commit .terraform.lock.hcl.
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/*.tfvars
**/*.tfvars.json
crash.log

# Local simulation runtime state, outboxes, & generated DuckDB databases
**/state.json
**/state.json.dryrun
**/state.lock
**/audit.jsonl
**/outbox.jsonl
**/outbox.quarantine.jsonl
**/*.duckdb
**/*.duckdb.wal
simulations/hpc/queue/running/*
simulations/hpc/queue/completed/*
simulations/hpc/queue/needs_human/*
simulations/hpc/queue/pending/*
!simulations/hpc/queue/**/.gitkeep

# Datasets, checkpoints, and scratch outputs
*.h5
*.hdf5
*.npz
*.orbax/
checkpoints/
outputs/
wandb/

# C/C++/Fortran/CUDA build artifacts
*.o
*.so
*.dylib
*.a
*.mod
CMakeFiles/
CMakeCache.txt
cmake-build-*/

# GKE / GCP local environment config (keep gcp.env.example tracked)
gcp.env
**/gcp.env

