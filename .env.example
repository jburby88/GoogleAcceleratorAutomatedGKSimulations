# ==============================================================================
# UT Austin x Google.org AI for Science — operator settings template
# Copy to `.env` (gitignored; `make env-init` creates it with mode 600).
# Read by scripts/deploy_gcp_demo.sh and the Makefile. The Makefile does NOT export these
# values to tests or other subprocesses.
# NEVER put the production bearer token here: in GCP it lives only in Secret Manager.
# ==============================================================================

# --- GCP project & region (scripts/deploy_gcp_demo.sh, Terraform) ---
# Required. The deploy script refuses this placeholder.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# One region for Cloud Run, Artifact Registry, GCS, BigQuery and Cloud Batch.
GCP_REGION=us-central1
# Build and push container images remotely via GCP Cloud Build (`gcloud builds submit`) by default
# so no local Docker daemon is required and x86_64 CUDA GX images build natively from Apple Silicon Macs.
# Set USE_CLOUD_BUILD=false to build locally with `docker build` + `docker push`.
USE_CLOUD_BUILD=true
# Optional: Terraform state bucket (default <project>-tfstate; created versioned and private).
# TF_STATE_BUCKET=

# --- aurora-steer (Vertex AI Gemini) ---
# Generally available Vertex AI model ID (validated at startup). gemini-3.8-flash is a
# lower-cost alternative for the short single-turn triage calls.
MODEL_ID=gemini-4-argon
GOOGLE_CLOUD_LOCATION=global
# Server-side Vertex AI deadline in seconds (must stay below the HPC client's 100 s timeout).
VERTEX_TIMEOUT_S=60

# --- Local development only ---
# aurora-steer URL used by `make tacc-smoke-test` (rewritten by `make gcp-deploy`).
AURORA_STEER_URL=http://127.0.0.1:8080
# Token for a LOCAL aurora-steer only. When empty, `make tacc-smoke-test` reads the deployed
# token from Secret Manager at run time (it is never written to disk).
AURORA_STEER_BEARER_TOKEN=
# Keep 0 locally: 1 streams telemetry rows into the production BigQuery tables
# (Cloud Run gets BQ_ENABLED=1 from Terraform).
BQ_ENABLED=0

# --- Dashboard (`make dashboard`; Cloud Run settings come from Terraform) ---
BQ_DATASET=sim_babysitter_telemetry
BQ_MAX_BYTES_BILLED=104857600
# The dashboard is never public. IAP needs an OAuth consent screen; with IAP off, the members
# below get Cloud Run invoker and open it via `gcloud run services proxy`.
ENABLE_DASHBOARD_IAP=true
DASHBOARD_AUTHORIZED_MEMBERS=group:your-team@example.org

# --- GCP Cloud Batch babysitter (config/batch_babysitter.json written by make gcp-deploy) ---
CAMPAIGN_ID=pilot_50
# Custom VPC + regional subnet for Cloud Batch VMs (Private Google Access is always enabled for free).
# Leave VPC_NAME_PREFIX empty to default to <GOOGLE_CLOUD_PROJECT>-{vpc,subnet,router,nat}; override VPC_SUBNET_CIDR
# (/8../24) if 10.0.0.0/16 overlaps UT Austin / TACC VPN, Interconnect or Shared VPC ranges.
VPC_NAME_PREFIX=
VPC_SUBNET_CIDR=10.0.0.0/16
# Cloud NAT is disabled by default (false) to avoid ~$32/mo standing idle NAT gateway charges.
# Enable (ENABLE_CLOUD_NAT=true) if your GCP environment Org Policy (constraints/compute.vmExternalIpAccess)
# does not allow VMs to have public IPs AND GPU VMs need outbound internet for driver installation.
ENABLE_CLOUD_NAT=false
# Set GCP_BATCH_NO_EXTERNAL_IP=true when VMs are prohibited from having public IPs by Org Policy;
# set false if your project allows ephemeral external IPs on Batch VMs (saving Cloud NAT idle costs).
GCP_BATCH_NO_EXTERNAL_IP=true
# 1 = CPU-only smoke test for projects without GPU quota; the babysitter then runs with
# environment=sim (never counted in KPIs). GX itself needs a GPU.
GCP_BATCH_CPU_ONLY=0
# Optional candidate regions for Cloud Batch GPU jobs. Terraform provisions a single regional subnet in GCP_REGION,
# so a pinned subnet requires candidate regions to stay co-located with GCP_REGION (leave unset to default to
# [GCP_REGION], unless matching regional subnets are provisioned for a {region} subnetwork template).
# GCP_BATCH_CANDIDATE_REGIONS=us-central1
# Written by `make gcp-deploy` for reference.
GK_DATASET_BUCKET=
# Required to build gx-runner: the 40-hex GX git commit compiled into the image (recorded in
# each run's provenance). Use the commit documented in simulations/gcp/README.md.
GX_COMMIT=

# --- Optional access integrations (Terraform) ---
# GitHub Actions deploy via Workload Identity Federation (main branch + "production" environment).
ENABLE_GITHUB_WIF=false
GITHUB_WIF_REPOSITORY=
# Comma-separated principals from UW allowed to create ToBlick/mrx equilibria (create-only).
UW_MRX_WRITER_MEMBERS=

# TACC driver settings (AURORA_STEER_BEARER_TOKEN, TACC_NOTIFY_WEBHOOK_URL, ...) are set on the
# TACC login node, not here: see simulations/hpc/README.md.
