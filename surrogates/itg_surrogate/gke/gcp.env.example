# Copy this template to `surrogates/itg_surrogate/gke/gcp.env` (gitignored) and fill in your GCP values:
#   cp surrogates/itg_surrogate/gke/gcp.env.example surrogates/itg_surrogate/gke/gcp.env

# --- Google Cloud Project & Location ---
PROJECT_ID=your-gcp-project-id
# Optional: auto-discovered via `gcloud projects describe` if left blank
PROJECT_NUMBER=
REGION=europe-west4
ZONE=europe-west4-a

# --- GKE Cluster & Node Pool ---
CLUSTER_NAME=gk-tpu-cluster
TPU_POOL_NAME=tpu-v6e-8-pool
K8S_NAMESPACE=default
KSA_NAME=itg-surrogate-ksa

# --- Artifact Registry & Container Image ---
AR_REPO=gk-simulations
IMAGE_NAME=itg-surrogate-tpu
IMAGE_TAG=latest
JAX_VERSION=0.11.2

# --- GCS Dataset & Sweep Results Storage (mounted via GKE GCS Fuse CSI) ---
GCS_BUCKET=your-gk-simulations-bucket
GCS_DATASET_OBJECT=datasets/20250102-01_GX_stellarator_dataset.h5
GCS_RESULTS_PREFIX=itg_surrogate/sweeps

# --- Cloud TPU Single-Host Preset ---
# Default: 8-chip Cloud TPU v6e (`ct6e-standard-8t`).
# Matches `num_seeds=8` in `itg_surrogate.registry.sweeps`, training all 8
# ensemble seeds simultaneously in a single GSPMD `Mesh(devices, ('ens',))` wave.
TPU_MACHINE_TYPE=ct6e-standard-8t
TPU_ACCELERATOR=tpu-v6e-slice
TPU_TOPOLOGY=2x4
TPU_CHIPS=8
# Comma-separated zones within REGION that physically host the chosen TPU SKU
# (e.g. `us-east5-b,us-east5-c` for v5p in us-east5, or `europe-west4-a` for v6e).
TPU_NODE_LOCATIONS=europe-west4-a

# Alternative single-host TPU presets (uncomment one block to switch):
# 1) Cloud TPU v6e-4 (4 chips, 2 waves per 8-seed experiment):
# TPU_MACHINE_TYPE=ct6e-standard-4t
# TPU_ACCELERATOR=tpu-v6e-slice
# TPU_TOPOLOGY=2x2
# TPU_CHIPS=4
#
# 2) Cloud TPU v5p-4 (4 chips, high-HBM Pod slice single host):
# TPU_MACHINE_TYPE=ct5p-hightpu-4t
# TPU_ACCELERATOR=tpu-v5p-slice
# TPU_TOPOLOGY=2x2x1
# TPU_CHIPS=4
#
# 3) Cloud TPU v5e-8 (8 chips, single wave per 8-seed experiment):
# TPU_MACHINE_TYPE=ct5lp-hightpu-8t
# TPU_ACCELERATOR=tpu-v5-lite-podslice
# TPU_TOPOLOGY=2x4
# TPU_CHIPS=8

# --- Autoscaling & Spot Configuration ---
# Scales TPU node pool down to 0 VMs when no sweep jobs are queued.
MAX_TPU_NODES=4
USE_SPOT=true
PARALLEL_SWEEPS=4
